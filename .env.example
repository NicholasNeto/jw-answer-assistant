# Copie para .env e ajuste. Se ADB_PATH ficar vazio usa 'adb' do PATH.
PORT=3000
ADB_PATH=/caminho/para/platform-tools/adb
SCRCPY_PATH=/caminho/para/scrcpy
# Opcional: escolher dispositivo quando há vários ligados
ADB_SERIAL=

# Gemini (chave em https://aistudio.google.com/apikey)
# gemini = real (gasta quota) | mock = simulado (sem custo). Os scripts npm sobrepõem isto.
AI_PROVIDER=gemini
# Só no mock: MOCK_ERROR=quota|auth|timeout|unavailable|empty e MOCK_DELAY_MS=600
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# Tempo máximo à espera do Gemini (ms). Aumente se der timeout.
GEMINI_TIMEOUT_MS=240000
WOL_LANG=pt
