# Copie para .env e ajuste. Se ADB_PATH ficar vazio usa 'adb' do PATH.
PORT=3000
ADB_PATH=/caminho/para/platform-tools/adb
SCRCPY_PATH=/caminho/para/scrcpy
# Opcional: escolher dispositivo quando há vários ligados
ADB_SERIAL=

# Gemini (chave em https://aistudio.google.com/apikey)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
