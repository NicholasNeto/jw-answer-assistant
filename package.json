{
  "name": "jw-answer-assistant",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js --real",
    "start:mock": "node src/server.js --mock",
    "dev": "node --watch src/server.js --mock",
    "dev:offline": "node --watch src/server.js --mock --mock-device",
    "dev:real": "node --watch src/server.js --real",
    "clipboard": "node index.js",
    "test": "node --test test/*.test.js",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm run dev:offline\" \"npm run web:dev\"",
    "dev:all:real": "concurrently -k -n api,web -c blue,green \"npm run dev:real\" \"npm run web:dev\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
